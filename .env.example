# Configuración local de DCIC-Flix.
#
# Este archivo es opcional: sin .env, docker-compose.yml usa los valores de desarrollo
# que figuran abajo. Para cambiar alguno:  cp .env.example .env  y editar .env.
# .env no va a Git.
#
# IMPORTANTE: MongoDB y RabbitMQ crean su usuario solo la primera vez, con el volumen
# vacío. Si cambiás usuario o contraseña después del primer `up`, los servicios no se
# van a poder conectar hasta recrear los volúmenes (borra los datos):
#   docker compose down -v

# Puerto del host donde se sirve la aplicación (http://localhost:8080).
FRONTEND_PORT=8080

# Usuario root de MongoDB. La base (peliculas-proyectos) es fija: la define dataset/mongo-init.sh.
MONGO_USER=dcicflix
MONGO_PASSWORD=dcicflix-dev

# Usuario de RabbitMQ.
RABBITMQ_USER=dcicflix
RABBITMQ_PASSWORD=dcicflix-dev

# API key del LLM. Opcional: sin ella la app funciona, y la traducción, el chat
# y la limpieza con LLM quedan deshabilitados.
LLM_API_KEY=

# Nivel de logs de los servicios Python: DEBUG, INFO, WARNING o ERROR.
LOG_LEVEL=INFO
